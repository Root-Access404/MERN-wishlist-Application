# Backend Configuration

# Server Port
PORT=5000

# Node Environment (development, production, staging)
NODE_ENV=development

# MongoDB URI - Required for database operations
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/wishlist_db?retryWrites=true&w=majority
# For local MongoDB:
# MONGO_URI=mongodb://localhost:27017/wishlist_db
MONGO_URI=

# Frontend URL - Used for CORS in production
# This should be your CloudFront domain or S3 website endpoint
# On EC2: set this to your CloudFront domain (Phase 6)
# Local dev: leave as http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Logging Level (optional)
LOG_LEVEL=info
